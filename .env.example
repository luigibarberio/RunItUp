# ==============================================================================
# CONFIGURAZIONE AMBIENTE LOCALE - RUNITUP
# ==============================================================================
# ISTRUZIONI PER IL TEAM:
# 1. Copia questo file e rinominalo in ".env" (senza .example)
# 2. Sostituisci i valori segnaposto con le tue credenziali e configurazioni locali
# 3. Il file .env è ignorato da Git per sicurezza: NON forzarne il commit!
# ==============================================================================

# ------------------------------------------------------------------------------
# PORTA DELL'APPLICAZIONE (Tomcat)
# ------------------------------------------------------------------------------
# Porta su cui vuoi accedere al sito dal browser (es. localhost:8080)
APP_PORT=8080

# ------------------------------------------------------------------------------
# DATABASE POSTGRESQL (Configurazione Docker)
# ------------------------------------------------------------------------------

# Porta su cui girerà PostgreSQL sul tuo PC (Default: 5432)
DB_PORT=5432

# Nome del database
DB_NAME=runitup_db

# Credenziali di accesso (Inserisci qui i tuoi dati)
DB_USER=postgres
DB_PASSWORD=password